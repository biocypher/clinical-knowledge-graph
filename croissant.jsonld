    {
      "@id": "https://doi.org/10.17632/mrcf7f4tc2.3",
      "@type": "sc:Dataset",
      "name": "Clinical Knowledge Graph",
      "description": "A database dump of the Clinical Knowledge Graph (CKG), an open-source platform integrating experimental data, biomedical databases, ontologies, and literature. The published files can be used to restore a Neo4j graph database containing the CKG resources.",
      "conformsTo": "http://mlcommons.org/croissant/1.0",
      "citeAs": "Santos, Alberto; Colaço, Ana Rita; Nielsen, Annelaura Bach; Mann, Matthias (2021), “Clinical Knowledge Graph”, Mendeley Data, V3, doi: 10.17632/mrcf7f4tc2.3",
