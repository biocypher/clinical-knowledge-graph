  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE/",
  "@id": "clinical-knowledge-graph-biocypher-adapter",
  "name": "Clinical Knowledge Graph BioCypher Adapter",
  "description": "A BioCypher adapter that streams data from a running Clinical Knowledge Graph Neo4j database and generates BioCypher-compatible outputs. It supports full graph migration, configurable subsetting, and preparation of subsets for Bioteque embedding workflows.",
  "version": "0.2.0",
